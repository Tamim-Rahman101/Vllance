@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vllance</title>
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
        rel="stylesheet">
</head>

<body>
    <div class="auth-container">
        <div class="auth-form-container">
            <a href="/" class="back-home">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to Home
            </a>

            <div class="auth-form-wrapper">
                <div class="form-header">
                    <h2 class="form-title">Forgot Password?</h2>
                    <p class="form-subtitle">We'll help you recover your account</p>
                </div>

                <form asp-action="ForgotPassword" method="post" class="auth-form">
                    @Html.AntiForgeryToken()

                    <!-- Email Field -->
                    <div class="form-group">
                        <label for="email" class="form-label">Email Address</label>
                        <div class="input-wrapper">
                            <input type="email" id="email" name="email" class="form-input"
                                placeholder="Enter your registered email" required />
                        </div>
                        <small style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 0.375rem; display: block;">
                            Enter the email address associated with your account
                        </small>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-primary">
                        <span>Send Reset Link</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 2L11 13"></path>
                            <path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
                        </svg>
                    </button>

                    <!-- Back to Login -->
                    <div class="form-footer">
                        <p>Remember your password? <a href="/Account/Login" class="link-primary">Back to Login</a></p>
                    </div>
                </form>

                <!-- Information Box -->
                <div class="info-box">
                    <div class="info-box-content">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <div>
                            <h4>What happens next?</h4>
                            <p>
                                If an account exists with this email, you'll receive a password reset link.
                                The link will be valid for 24 hours. Check your spam folder if you don't see it.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
