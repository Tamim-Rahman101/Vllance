@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vllance - Smart Vehicle Surveillance</title>
    <link rel="stylesheet" href="~/css/homepage.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <span class="logo-icon">???</span>
                <span class="logo-text">Vllance</span>
            </div>
            <div class="nav-links">
                <a href="#home" class="nav-link active">Home</a>
                <a href="#features" class="nav-link">Features</a>
                <a href="#how-it-works" class="nav-link">How It Works</a>
                <a href="#contact" class="nav-link">Contact</a>
                <a href="/Login" class="nav-btn login-btn">Login</a>
                <a href="/Register" class="nav-btn register-btn">Register</a>
            </div>
            <div class="mobile-menu-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-text fade-in">
                <h1 class="hero-title">Smart Vehicle Surveillance<br/>for a Safer Campus</h1>
                <p class="hero-subtitle">Monitor, Lock, and Protect Your Vehicle — Anytime, Anywhere.</p>
                <div class="hero-buttons">
                    <a href="/Login" class="btn btn-outline">Login</a>
                    <a href="/Register" class="btn btn-primary">Register</a>
                </div>
            </div>
            <div class="hero-illustration fade-in-delay">
                <svg viewBox="0 0 800 600" class="illustration">
                    <!-- Car illustration -->
                    <defs>
                        <linearGradient id="carGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#5EC2B7;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#7DD3C0;stop-opacity:1" />
                        </linearGradient>
                        <linearGradient id="windowGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#E8F5F4;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#D4EDE9;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                    <!-- Car body -->
                    <rect x="200" y="300" width="400" height="150" rx="20" fill="url(#carGradient)" opacity="0.9"/>
                    <rect x="250" y="250" width="300" height="80" rx="15" fill="url(#carGradient)" opacity="0.8"/>
                    <!-- Windows -->
                    <rect x="270" y="265" width="100" height="50" rx="8" fill="url(#windowGradient)" opacity="0.9"/>
                    <rect x="430" y="265" width="100" height="50" rx="8" fill="url(#windowGradient)" opacity="0.9"/>
                    <!-- Wheels -->
                    <circle cx="280" cy="450" r="40" fill="#64748b"/>
                    <circle cx="280" cy="450" r="25" fill="#94a3b8"/>
                    <circle cx="520" cy="450" r="40" fill="#64748b"/>
                    <circle cx="520" cy="450" r="25" fill="#94a3b8"/>
                    <!-- Security cameras -->
                    <circle cx="150" cy="150" r="30" fill="#5EC2B7" opacity="0.2" class="pulse"/>
                    <circle cx="150" cy="150" r="15" fill="#5EC2B7"/>
                    <line x1="165" y1="150" x2="250" y2="280" stroke="#5EC2B7" stroke-width="2" stroke-dasharray="5,5" opacity="0.5"/>
                    
                    <circle cx="650" cy="150" r="30" fill="#7DD3C0" opacity="0.2" class="pulse"/>
                    <circle cx="650" cy="150" r="15" fill="#7DD3C0"/>
                    <line x1="635" y1="150" x2="550" y2="280" stroke="#7DD3C0" stroke-width="2" stroke-dasharray="5,5" opacity="0.5"/>
                    <!-- Lock icon on car -->
                    <circle cx="400" cy="375" r="25" fill="white" opacity="0.95"/>
                    <path d="M 395 370 L 395 360 Q 395 352 400 352 Q 405 352 405 360 L 405 370 M 390 370 L 410 370 L 410 385 L 390 385 Z" fill="#5EC2B7"/>
                </svg>
            </div>
        </div>
        <div class="scroll-indicator">
            <div class="mouse">
                <div class="wheel"></div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
        <div class="container">
            <h2 class="section-title">What You Can Do</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v4m-6 6l6 6m0-6l-6 6M3 3l6 6m0-6L3 9"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </div>
                    <h3 class="feature-title">Real-Time Vehicle Detection</h3>
                    <p class="feature-description">Advanced AI monitors your vehicle 24/7 with instant detection capabilities.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h3 class="feature-title">Lock & Unlock Remotely</h3>
                    <p class="feature-description">Control your vehicle's security from anywhere with one-tap lock/unlock.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <h3 class="feature-title">Instant Movement Alerts</h3>
                    <p class="feature-description">Get real-time notifications when unauthorized movement is detected.</p>
                </div>
                
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="feature-title">Admin & Zone Management</h3>
                    <p class="feature-description">Comprehensive dashboard for managing users, zones, and security settings.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works" id="how-it-works">
        <div class="container">
            <h2 class="section-title">How It Works</h2>
            <div class="steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 20V10"></path>
                            <path d="M12 20V4"></path>
                            <path d="M6 20v-6"></path>
                        </svg>
                    </div>
                    <h3 class="step-title">Register Your Vehicle</h3>
                    <p class="step-description">Create an account and add your vehicle details with photos.</p>
                </div>
                
                <div class="step-connector"></div>
                
                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h3 class="step-title">Lock It From the Web App</h3>
                    <p class="step-description">Use our intuitive dashboard to secure your vehicle remotely.</p>
                </div>
                
                <div class="step-connector"></div>
                
                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <h3 class="step-title">Get Instant Alerts</h3>
                    <p class="step-description">Receive immediate notifications for any suspicious activity.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer" id="contact">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <span class="logo-icon">???</span>
                    <span class="logo-text">Vllance</span>
                </div>
                <div class="footer-links">
                    <a href="#home">Home</a>
                    <a href="#features">Features</a>
                    <a href="#how-it-works">How It Works</a>
                    <a href="/Privacy">Privacy Policy</a>
                    <a href="/Terms">Terms of Service</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Vllance - Web-Based Vehicle Surveillance System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/homepage.js"></script>
</body>
</html>
